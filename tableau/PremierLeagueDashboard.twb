          <datasource-dependencies datasource='federated.09u3gzs1r3uyb91bj6q850vs62jl'>
            <column datatype='integer' name='[Away Goals]' role='measure' type='quantitative' />
            <column caption='Average Goals Per Match' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0114355867250689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Goals Home]) + SUM([Away Goals])) / COUNT([date])' />
